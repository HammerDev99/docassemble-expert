# Copie este archivo a .streamlit/secrets.toml (ignorado por git) y complete los valores.
# Todas las claves también pueden definirse como variables de entorno con el mismo nombre.

# --- Obligatorias ---
OPENAI_API_KEY = "sk-..."
MISTRAL_API_KEY = "..."

# --- Asistente (antes vivían en el objeto Assistant de OpenAI) ---
# Modelo de la Responses API. Por defecto: gpt-5.4-mini
# OPENAI_MODEL = "gpt-5.5"

# Instrucciones del sistema. Por defecto se leen de prompts/docassembleexpert_instrucciones.md.
# Use este secreto solo para sobreescribirlas sin cambiar el código.
# ASSISTANT_INSTRUCTIONS = """
# Eres DocAssemble Expert...
# """

# Base de conocimiento (file_search). Créela con:
#   python scripts/crear_vector_store.py
# y pegue aquí el ID que imprime. Varios IDs separados por coma.
# VECTOR_STORE_ID = "vs_..."

# --- Parámetros opcionales del modelo (se omiten si no se definen) ---
# OPENAI_TEMPERATURE = "0.2"          # No soportado por todos los modelos de razonamiento
# OPENAI_TOP_P = "1.0"
# OPENAI_MAX_OUTPUT_TOKENS = "2000"
# OPENAI_REASONING_EFFORT = "low"     # none | low | medium | high (según modelo)
# OPENAI_MAX_HISTORY_MESSAGES = "40"  # Mensajes del historial enviados por turno
# OPENAI_MAX_DOC_CHARS = "5000"       # Caracteres por documento OCR inyectados
# OPENAI_STORE = "false"              # true para que OpenAI conserve las respuestas 30 días

# --- Opcionales de la aplicación ---
# ANALYTICS_SCRIPT = "<script defer src='...' data-website-id='...'></script>"
# FEEDBACK_URL = "https://forms.office.com/r/..."
